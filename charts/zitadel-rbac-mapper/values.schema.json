{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zitadel-rbac-mapper chart values",
  "description": "Strict at the top level: unknown keys are rejected so a typo fails the render instead of being silently ignored. Kubernetes passthrough fields (resources, selectors, rules, security contexts) stay open.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "resources": { "type": "object" },
    "env": {
      "type": "object",
      "description": "Environment variables, rendered verbatim. Values must be strings (quote numbers).",
      "additionalProperties": { "type": "string" }
    },
    "envFrom": { "type": "array", "items": { "type": "object" } },
    "zitadelKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": { "type": "string" },
        "secretKey": { "type": "string" },
        "mountPath": { "type": "string" }
      }
    },
    "orgsConfig": {
      "type": "object",
      "description": "v2 org-aware config, rendered verbatim into the ConfigMap — see config.example.yaml."
    },
    "syncAPIKey": { "type": "string" },
    "cronJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "concurrencyPolicy": { "enum": ["Allow", "Forbid", "Replace"] },
        "resources": { "type": "object" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array", "items": { "type": "object" } },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ciliumNetworkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" }
  }
}
